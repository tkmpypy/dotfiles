{
  "extends": [
    "mergeConfidence:all-badges",
    "config:recommended",
    ":timezone(Asia/Tokyo)",
    ":prHourlyLimitNone",
    "github>aquaproj/aqua-renovate-config:file(.config/aqua/aqua.yaml)#2.13.0"
  ],
  "ignoreTests": true,
  "schedule": [
    "before 9am"
  ],
  "automergeSchedule": [
    "before 9am"
  ],
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "dependencyDashboard": true,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ],
  "enabledManagers": [
    "custom.regex"
  ]
}
